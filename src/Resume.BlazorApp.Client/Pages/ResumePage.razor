@page "/"
@rendermode InteractiveAuto
@implements IAsyncDisposable
@using Resume.Contracts
@inject ResumeApiClient Api
@inject IJSRuntime JS

<PageTitle>Resume</PageTitle>

<div class="resume-page">
    @if (_personalInfo is null)
    {
        <p>Loading...</p>
    }
    else
    {
        <header class="resume-header">
            <h1>@_personalInfo.FullName</h1>
            <p class="resume-header__headline">@_personalInfo.Headline</p>
            <p class="resume-header__contact">
                @foreach (var (value, index) in ContactDetails.Select((value, index) => (value, index)))
                {
                    if (index > 0)
                    {
                        <span class="resume-header__separator"> | </span>
                    }
                    <span>@value</span>
                }
            </p>
        </header>

        <div class="resume-intro">
            <p>@_personalInfo.Summary</p>
            @if (_adminMode)
            {
                <PersonalInfoForm PersonalInfo="_personalInfo" OnSaved="HandleSaved" />
            }
        </div>

        <div class="resume-page__toolbar">
            <button @onclick="ToggleAdminMode">@(_adminMode ? "Exit Admin Mode" : "Admin Mode")</button>
        </div>

        <ResumeSection Title="Skills">
            @foreach (var (group, index) in _skills.GroupBy(s => s.Category).Select((group, index) => (group, index)))
            {
                <ResumeSubsection Title="@group.Key" InitiallyExpanded="@(index == 0)">
                    <ul>
                        @foreach (var skill in group.OrderBy(s => s.SortOrder))
                        {
                            <li>
                                @skill.Name
                                @if (_adminMode)
                                {
                                    <button @onclick="() => _editingSkill = skill">Edit</button>
                                }
                            </li>
                        }
                    </ul>
                </ResumeSubsection>
            }
            @if (_adminMode)
            {
                <SkillForm EditingSkill="_editingSkill" OnSaved="HandleSkillSaved" />
            }
        </ResumeSection>

        <ResumeSection Title="Experience">
            @foreach (var (job, index) in _experience.Select((job, index) => (job, index)))
            {
                <ResumeSubsection Title="@job.Company"
                                  Meta="@FormatExperienceMeta(job)"
                                  InitiallyExpanded="@(index == 0)">
                    @if (_adminMode)
                    {
                        <p><button @onclick="() => _editingExperience = job">Edit</button></p>
                    }
                    <ul>
                        @foreach (var highlight in job.Highlights)
                        {
                            <li>@highlight</li>
                        }
                    </ul>
                </ResumeSubsection>
            }
            @if (_adminMode)
            {
                <ExperienceForm EditingEntry="_editingExperience" OnSaved="HandleExperienceSaved" />
            }
        </ResumeSection>

        <ResumeSection Title="Education">
            @foreach (var (edu, index) in _education.Select((edu, index) => (edu, index)))
            {
                <ResumeSubsection Title="@edu.Institution" InitiallyExpanded="@(index == 0)">
                    @if (_adminMode)
                    {
                        <p><button @onclick="() => _editingEducation = edu">Edit</button></p>
                    }
                    <p>@string.Join(", ", new[] { edu.Degree, edu.FieldOfStudy }.Where(v => !string.IsNullOrWhiteSpace(v)))</p>
                    <p>@FormatRange(edu.StartDate, edu.EndDate)</p>
                    @if (edu.Details.Length > 0)
                    {
                        <ul>
                            @foreach (var detail in edu.Details)
                            {
                                <li>@detail</li>
                            }
                        </ul>
                    }
                </ResumeSubsection>
            }
            @if (_adminMode)
            {
                <EducationForm EditingEntry="_editingEducation" OnSaved="HandleEducationSaved" />
            }
        </ResumeSection>
    }

    @if (_banner is not null)
    {
        <div class="resume-banner">@_banner</div>
    }
</div>

@code {
    private const string SavedBanner = "Saved — but this is a demo; changes are not actually persisted.";

    private PersonalInfoResponse? _personalInfo;
    private List<SkillResponse> _skills = [];
    private List<ExperienceResponse> _experience = [];
    private List<EducationResponse> _education = [];
    private bool _adminMode;
    private string? _banner;
    private SkillResponse? _editingSkill;
    private ExperienceResponse? _editingExperience;
    private EducationResponse? _editingEducation;
    private IJSObjectReference? _stickyHeaderModule;
    private IJSObjectReference? _stickyHeaderObserver;
    private bool _stickyHeaderRequested;

    private static string FormatRange(DateOnly startDate, DateOnly? endDate) =>
        $"{startDate:MMM yyyy} - {(endDate?.ToString("MMM yyyy") ?? "Present")}";

    private static string FormatExperienceMeta(ExperienceResponse job) =>
        $"{job.JobTitle} · {FormatRange(job.StartDate, job.EndDate)}";

    private IEnumerable<string> ContactDetails =>
        new[] { _personalInfo?.Location, _personalInfo?.Phone, _personalInfo?.Email }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!);

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The header only exists once personal info has loaded, so this waits
        // for the render that produces it rather than keying off firstRender.
        // The flag is set before the first await: OnAfterRenderAsync can fire
        // again while the import is still in flight, which would otherwise
        // attach a second observer.
        if (_personalInfo is null || _stickyHeaderRequested)
        {
            return;
        }

        _stickyHeaderRequested = true;
        _stickyHeaderModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/resume-sticky-header.js");
        _stickyHeaderObserver = await _stickyHeaderModule.InvokeAsync<IJSObjectReference>(
            "observeHeader");
    }

    private async Task LoadAllAsync()
    {
        _personalInfo = await Api.GetPersonalInfoAsync();
        _skills = await Api.GetSkillsAsync();
        _experience = await Api.GetExperienceAsync();
        _education = await Api.GetEducationAsync();
    }

    private void ToggleAdminMode() => _adminMode = !_adminMode;

    private async Task HandleSaved()
    {
        _banner = SavedBanner;
        await LoadAllAsync();
    }

    private async Task HandleSkillSaved()
    {
        _editingSkill = null;
        _banner = SavedBanner;
        await LoadAllAsync();
    }

    private async Task HandleExperienceSaved()
    {
        _editingExperience = null;
        _banner = SavedBanner;
        await LoadAllAsync();
    }

    private async Task HandleEducationSaved()
    {
        _editingEducation = null;
        _banner = SavedBanner;
        await LoadAllAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_stickyHeaderModule is null)
        {
            return;
        }

        try
        {
            if (_stickyHeaderObserver is not null)
            {
                await _stickyHeaderObserver.InvokeVoidAsync("disconnect");
                await _stickyHeaderObserver.DisposeAsync();
            }

            await _stickyHeaderModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; the observer went with it.
        }
    }
}
